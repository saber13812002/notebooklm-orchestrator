# NLO P5-1A — Stage environment for docker-compose.stage.yml.
#
# Copy to /home/saber/nlo-stage/.env and chmod 600. No real secrets in this
# file; the Stage admin token is minted in the Stage's own DB and stored only
# at /home/saber/nlo-stage/tokens/ (never in git, never printed in reports).

# Stage host-side port (loopback only; production owns 127.0.0.1:4870)
NLO_STAGE_PORT=4871

# Image tag = the CI-green commit this Stage was built from
# (set to the actual SHA at deploy time)
NLO_STAGE_TAG=

# Stage host uid/gid (saber on 172.30.0.133)
NLO_UID=1001
NLO_GID=1001

# Mock provider — Stage never makes live NotebookLM requests
NLO_PROVIDER=mock
NLO_PROXY_RUNTIME=mock

# /api/v1 requires a Stage-minted token (minted via bootstrap:admin inside
# the Stage container; distinct from any production token)
NLO_API_AUTH=1

# Webhook SSRF gate (fail-closed by default). docker-compose.stage.yml pins
# this to 1 for Stage so the Gate-F mock receiver can be reached at
# 127.0.0.1 inside the container. Omitted here on purpose: the value is a
# Stage-environment decision baked into the compose file, not a secret.
# Production deployments do NOT set this (no webhook loopback delivery).

# Hard timeout per job (ms).
NLO_JOB_TIMEOUT_MS=1800000

# NLO-O1 (2026-11-25): hourly auto-retry — re-queue FAILED jobs every hour
# (unlimited retries until output). 1 = on (Stage default in compose).
NLO_AUTO_RETRY=1
NLO_AUTO_RETRY_INTERVAL_MS=3600000
NLO_AUTO_RETRY_MAX_PER_SWEEP=20

# NLO-O1: hourly session keep-alive (python-worker provider only; the mock
# provider has no real sessions, so leave it 0 on Stage).
NLO_SESSION_REFRESH=0
NLO_SESSION_REFRESH_INTERVAL_MS=3600000
